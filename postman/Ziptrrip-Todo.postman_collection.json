{
  "info": {
    "_postman_id": "6c7e7f1e-4b5e-4e9d-9e4c-ziptrrip-todo",
    "name": "Ziptrrip Todo API",
    "description": "Postman collection for the Ziptrrip Todo backend assignment. Covers health, CRUD, validation, partial updates and error cases.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1"
    },
    {
      "key": "todoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "http://localhost:5000/health"
      }
    },
    {
      "name": "Todos",
      "item": [
        {
          "name": "Get All Todos",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/todos"
          }
        },
        {
          "name": "Create Todo",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('Todo was created', function () {",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.data.id).to.exist;",
                  "});",
                  "",
                  "pm.collectionVariables.set('todoId', json.data.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Prepare Ziptrrip assignment\",\n  \"description\": \"Complete backend and frontend implementation\",\n  \"priority\": \"HIGH\",\n  \"dueDate\": \"2026-09-23T12:00:00.000Z\"\n}"
            },
            "url": "{{baseUrl}}/todos"
          }
        },
        {
          "name": "Get Todo By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/todos/{{todoId}}"
          }
        },
        {
          "name": "Update Todo",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Complete Ziptrrip assignment\",\n  \"priority\": \"MEDIUM\"\n}"
            },
            "url": "{{baseUrl}}/todos/{{todoId}}"
          }
        },
        {
          "name": "Mark Todo Complete",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"completed\": true\n}"
            },
            "url": "{{baseUrl}}/todos/{{todoId}}"
          }
        },
        {
          "name": "Clear Due Date",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dueDate\": null\n}"
            },
            "url": "{{baseUrl}}/todos/{{todoId}}"
          }
        },
        {
          "name": "Delete Todo",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/todos/{{todoId}}"
          }
        }
      ]
    },
    {
      "name": "Validation",
      "item": [
        {
          "name": "Invalid Todo Payload",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"\",\n  \"priority\": \"URGENT\"\n}"
            },
            "url": "{{baseUrl}}/todos"
          }
        },
        {
          "name": "Empty PATCH Payload",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": "{{baseUrl}}/todos/{{todoId}}"
          }
        },
        {
          "name": "Invalid Todo ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/todos/abc"
          }
        },
        {
          "name": "Todo Not Found",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/todos/999999"
          }
        }
      ]
    }
  ]
}